# Any Postgres URL works; postgres:// and postgresql:// are rewritten to use psycopg 3.
# Neon example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/room_booking

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Signs login tokens. Required with a real database (32+ random characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=paste-a-long-random-string-here

# Seed the "Nimbus Technologies" demo workspace when the database is empty.
SEED_DEMO_DATA=true

# Optional: keep this app's tables in their own schema to share a database with another app.
# DB_SCHEMA=roomsync
